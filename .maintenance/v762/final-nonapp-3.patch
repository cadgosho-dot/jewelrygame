diff --git a/mnt/data/z762/scripts/check-save-storage-policy.py b/scripts/check-save-storage-policy.py
new file mode 100644
index 0000000..45aea92
--- /dev/null
+++ b/scripts/check-save-storage-policy.py
@@ -0,0 +1,28 @@
+#!/usr/bin/env python3
+"""Validate long-play localStorage quota recovery policy."""
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+APP = (ROOT / 'js/app.js').read_text(encoding='utf-8')
+
+checks = {
+    '容量超過判定がある': 'function isLocalStorageQuotaError(error)' in APP,
+    '端末1コピー節約モードがある': "'single-copy'" in APP and 'function enableLocalSingleCopyMode()' in APP,
+    '容量不足時に重複バックアップを解放する': 'removeLocalStorageItemQuietly(localSaveBackupKey())' in APP and 'removeLocalStorageItemQuietly(localSavePreMigrationKey())' in APP,
+    '破損診断へ巨大なraw全文を保存しない': 'rawCharacters: String(raw).length' in APP and '\n      raw,\n' not in APP[APP.index('function preserveCorruptLocalSave'):APP.index('function localSavedState')],
+    '正常読込時に旧pre-migrationを解放する': 'removeLocalStorageItemQuietly(localSavePreMigrationKey());' in APP[APP.index('function localSavedState'):APP.index('function preferredSavedState')],
+    '端末書込前にクラウド用snapshotを確保する': 'snapshot = createCloudSnapshot ? JSON.parse(nextRaw) : null;' in APP,
+    '容量不足時に最新端末セーブを再試行する': 'quotaRecoveryUsed = true;\n      writePrimary();' in APP,
+    '端末保存失敗でもクラウド保存へ進む': "端末保存失敗／クラウド保存を続行しています" in APP and '.then(() => saveState(userId, snapshot))' in APP,
+    '端末とクラウド両方失敗時の表示がある': '保存できませんでした／${cloudMessage}' in APP,
+}
+
+failed = [label for label, ok in checks.items() if not ok]
+for label, ok in checks.items():
+    print(('OK' if ok else 'NG') + ': ' + label)
+
+if failed:
+    print('\nSAVE STORAGE POLICY: FAIL')
+    sys.exit(1)
+print('\nSAVE STORAGE POLICY: PASS')
diff --git a/mnt/data/z762/tools/validate-diamond-polishing-lap-event.mjs b/tools/validate-diamond-polishing-lap-event.mjs
new file mode 100644
index 0000000..9b7cce8
--- /dev/null
+++ b/tools/validate-diamond-polishing-lap-event.mjs
@@ -0,0 +1,43 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const app = fs.readFileSync(path.join(ROOT, 'js/app.js'), 'utf8');
+const errors = [];
+
+const advanceStart = app.indexOf('async function advanceDiamondPolishingLapEvent()');
+const advanceEnd = app.indexOf('\n\nfunction nextOkachimachiQuizTriggerAt()', advanceStart);
+if (advanceStart < 0 || advanceEnd < 0) {
+  errors.push('ダイヤモンド研磨盤イベントの進行関数を確認できません');
+} else {
+  const block = app.slice(advanceStart, advanceEnd);
+  if (!block.includes("eventState.stage === 'outro'")) errors.push('終了ステージがありません');
+  if (!block.includes("eventState.active = false;")) errors.push('終了時にイベントを非アクティブ化していません');
+  if (!block.includes("eventState.stage = 'completed';")) errors.push('終了時にcompletedへ移行していません');
+  if (!block.includes("await eatMeal('indian', { skipEventCheck: true });")) {
+    errors.push('終了後に通常のインド料理の食事へ復帰する処理がありません');
+  }
+  if (block.includes("setScreen('meal', {}, false);")) {
+    errors.push('終了時に食事一覧へ戻る旧処理が残っています');
+  }
+}
+
+const renderStart = app.indexOf('function renderDiamondPolishingLapEvent()');
+const renderEnd = app.indexOf('\n\nfunction mainMenuIcon(', renderStart);
+if (renderStart < 0 || renderEnd < 0) {
+  errors.push('ダイヤモンド研磨盤イベントの描画関数を確認できません');
+} else {
+  const block = app.slice(renderStart, renderEnd);
+  if (!block.includes("タップすると通常のインド料理の食事へ")) {
+    errors.push('最後の案内文が通常のインド料理への遷移を示していません');
+  }
+}
+
+if (errors.length) {
+  console.error('ダイヤモンド研磨盤イベント検証: NG');
+  for (const error of errors) console.error(`- ${error}`);
+  process.exit(1);
+}
+console.log('ダイヤモンド研磨盤イベント検証: OK');
+console.log('イベント終了後に通常のインド料理の食事演出へ移行します。');
