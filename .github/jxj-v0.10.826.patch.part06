+  max-width:min(54vw,300px)!important;
+  max-height:min(34dvh,300px)!important;
+  object-fit:contain!important;
+  object-position:center center!important;
+}
+@media (orientation:landscape){
+  body[data-screen="okachimachiQuiz"] .jxj-quiz-king-v2 .jxj-quiz-reward-gem-v2{
+    max-width:min(26vw,270px)!important;
+    max-height:min(42dvh,250px)!important;
+  }
+}
+
